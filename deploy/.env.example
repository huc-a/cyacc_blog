# Copy to deploy/.env. Generate distinct random values (at least 24 characters).
POSTGRES_PASSWORD=
MIGRATION_PASSWORD=
DB_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SITE_URL=https://blog.example.com
RELEASE_TAG=v1.0.0
# This listener is for a TLS reverse proxy on the host. Keep it on loopback.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
COOKIE_SECURE=true
UMAMI_URL=
# Optional full API base; Cloud: https://api.umami.is/v1. Overrides UMAMI_URL.
UMAMI_API_URL=
UMAMI_WEBSITE_ID=
UMAMI_TOKEN=
UMAMI_SCRIPT_URL=
# Resolve relative to deploy/. Keep backups outside Git and offsite as well.
BACKUP_DIR=../.local/backups

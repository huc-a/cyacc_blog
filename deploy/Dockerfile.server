FROM maven:3.9-eclipse-temurin-17@sha256:1a352420f7aba21f5ad08df31bab55f74c013fb491f1ae8ab1dd7ff9ed698584 AS build
WORKDIR /src
COPY server/pom.xml ./pom.xml
RUN mvn -B -ntp dependency:go-offline
COPY server/src ./src
RUN mvn -B -ntp package -DskipTests

FROM eclipse-temurin:17-jre-jammy@sha256:b3054a20e1a851574cdb1692dd0db5310c647e62214a2a7abecbec1b9e3ae8f1
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 blog && useradd --uid 10001 --gid blog --no-create-home blog \
    && mkdir -p /app/uploads && chown blog:blog /app/uploads
WORKDIR /app
COPY --from=build /src/target/caiya-server-*.jar /app/server.jar
USER blog
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-jar", "/app/server.jar"]
